# Local development defaults only. Change them for anything shared.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
EVENTS_TOPIC=commerce.events.v1
DLQ_TOPIC=commerce.events.dlq.v1

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=commerce-bronze

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=commerce
CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_READONLY_USER=assistant_ro
CLICKHOUSE_READONLY_PASSWORD=change-me

# Optional. Leave empty to run without the assistant's LLM.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
